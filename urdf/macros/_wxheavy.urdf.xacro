<?xml version="1.0" encoding="utf-8"?>
<robot name="wxheavy" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="robot_model"
    value="wxheavy"
    scope="local"/>

  <xacro:include filename="$(find trossen_arm_description)/urdf/peripherals/zed_camera.urdf.xacro" />

  <xacro:macro name="wxheavy" params="prefix:=''">

    <xacro:property name="mesh_directory" value="package://trossen_arm_description/meshes/${robot_model}"/>

    <!-- TODO(abhismirai42): ros2_control -->

    <link name="${prefix}base_link">
      <inertial>
        <origin
          xyz="-0.01019070 -0.00000943 0.04760850"
          rpy="0 0 0" />
        <mass value="1.36323000"/>
        <inertia
          ixx="0.00231528"
          ixy="-0.00000086"
          ixz="-0.00021389"
          iyy="0.00313916"
          iyz="0.00000031"
          izz="0.00320515"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/base_link.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/base_link.obj"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}link_1">
      <inertial>
        <origin
          xyz="0.02328170 0.0 0.03956140"
          rpy="0 0 0"/>
        <mass value="0.71976300"/>
        <inertia
          ixx="0.00112465"
          ixy="0.0"
          ixz="-0.00014720"
          iyy="0.00080447"
          iyz="0.0"
          izz="0.00119080"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_1.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_1.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_0" type="revolute">
      <origin
        xyz="0 0 0.109"
        rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <axis xyz="0 0 1"/>
      <limit
        lower="${-radians(180 - 5)}"
        upper="${radians(180 - 5)}"
        effort="27.0"
        velocity="3.375" />
    </joint>

    <link name="${prefix}link_2">
      <inertial>
        <origin
          xyz="-0.25315200 0.0 0.0"
          rpy="0 0 0" />
        <mass value="1.31276000"/>
        <inertia
          ixx="0.00094059"
          ixy="0.0"
          ixz="0.0"
          iyy="0.02273520"
          iyz="0.0"
          izz="0.02309920"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_2.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_2.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_1" type="revolute">
      <origin
        xyz="0.032576 0 0.0485"
        rpy="0 0 0" />
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <axis xyz="0 1 0"/>
      <limit
        lower="0.0"
        upper="${pi}"
        effort="27.0"
        velocity="3.375" />
    </joint>

    <link name="${prefix}link_3">
      <inertial>
        <origin
          xyz="0.21528200 0.00022546 0.06284670"
          rpy="0 0 0" />
        <mass value="1.65476000"/>
        <inertia
          ixx="0.00114570"
          ixy="-0.00007094"
          ixz="-0.00077583"
          iyy="0.02861630"
          iyz="-0.00000084"
          izz="0.02887320"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_3.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_3.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_2" type="revolute">
      <origin
        xyz="-0.43 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <axis xyz="0 -1 0"/>
      <limit
        lower="0.0"
        upper="${3 * pi / 4}"
        effort="27.0"
        velocity="3.375" />
    </joint>

    <link name="${prefix}link_4">
      <inertial>
        <origin
          xyz="0.04792001 0.0 0.05741396"
          rpy="0 0 0" />
        <mass value="0.69237200"/>
        <inertia
          ixx="0.00111193"
          ixy="0.0"
          ixz="-0.00035591"
          iyy="0.00102592"
          iyz="0.0"
          izz="0.00092026"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_4.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_4.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_3" type="revolute">
      <origin
        xyz="0.405655 0 0.0651"
        rpy="0 0 0" />
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <axis xyz="0 -1 0"/>
      <limit
        lower="-${pi / 2}"
        upper="${pi / 2}"
        effort="7.0"
        velocity="7.0" />
    </joint>

    <link name="${prefix}link_5">
      <inertial>
        <origin
          xyz="-0.00579062 0.00000000 -0.02720844"
          rpy="0 0 0" />
        <mass value="0.07121851"/>
        <inertia
          ixx="0.00004021"
          ixy="0.00000000"
          ixz="-0.00000666"
          iyy="0.00003792"
          iyz="0.00000000"
          izz="0.00001254"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_5.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_5.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_4" type="revolute">
      <origin
        xyz="0.065 0 0.048"
        rpy="0 0 0" />
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <axis xyz="0 0 -1"/>
      <limit
        lower="-${pi / 2}"
        upper="${pi / 2}"
        effort="7.0"
        velocity="7.0" />
    </joint>

    <link name="${prefix}link_6">
      <inertial>
        <origin
          xyz="0.06129266 -0.00002029 -0.00026366"
          rpy="0 0 0" />
        <mass value="0.84380465"/>
        <inertia
          ixx="0.00046982"
          ixy="-0.00000111"
          ixz="-0.00001431"
          iyy="0.00127174"
          iyz="-0.00000064"
          izz="0.00130342"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_6.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_6.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_5" type="revolute">
      <origin
        xyz="-0.012 0.0 -0.048"
        rpy="0 0 0" />
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <axis xyz="1 0 0"/>
      <limit
        lower="-${pi}"
        upper="${pi}"
        effort="7.0"
        velocity="7.0" />
    </joint>

    <!-- TODO(abhismirai42): verify inertial properties carriage_links, gripper_links and camera_link -->
    <link name="${prefix}carriage_right">
      <inertial>
        <origin
          xyz="0.01255019 0.00449652 0.00963255"
          rpy="0 0 0" />
        <mass value="0.06140653"/>
        <inertia
          ixx="0.0000091193"
          ixy="-0.0000005807"
          ixz="-0.0000082661"
          iyy="0.0000310840"
          iyz="-0.0000004457"
          izz="0.0000224261"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/carriage_right.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/carriage_right.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}right_carriage_joint" type="prismatic">
      <origin
        xyz="0.1285 -0.0225 0"
        rpy="0 0 ${pi / 2}" />
      <parent link="${prefix}link_6"/>
      <child link="${prefix}carriage_right"/>
      <mimic joint="${prefix}left_carriage_joint"/>
      <axis xyz="-1 0 0"/>
      <limit
        lower="0.0"
        upper="0.044"
        effort="400.0"
        velocity="0.0875" />
    </joint>

    <link name="${prefix}carriage_left">
      <inertial>
        <origin
          xyz="0.01255019 0.00449652 0.00963255"
          rpy="0 0 0" />
        <mass value="0.06140653"/>
        <inertia
          ixx="0.0000091193"
          ixy="-0.0000005807"
          ixz="-0.0000082661"
          iyy="0.0000310840"
          iyz="-0.0000004457"
          izz="0.0000224261"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/carriage_left.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/carriage_left.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}left_carriage_joint" type="prismatic">
      <origin
        xyz="0.1285 0.0225 0"
        rpy="${pi} 0 -${pi / 2}" />
      <parent link="${prefix}link_6"/>
      <child link="${prefix}carriage_left"/>
      <axis xyz="-1 0 0"/>
      <limit
        lower="0.0"
        upper="0.044"
        effort="400.0"
        velocity="0.0875" />
    </joint>

    <link name="${prefix}gripper_left">
      <inertial>
        <origin
          xyz="0.00275423 0.00000726 0.02059910"
          rpy="0 0 0" />
        <mass value="0.03751074"/>
        <inertia
          ixx="0.00002087"
          ixy="0.00000000"
          ixz="-0.00000338"
          iyy="0.00002044"
          iyz="0.00000000"
          izz="0.00000456"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/gripper_left.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/gripper_left.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}left_gripper_joint" type="fixed">
      <origin
        xyz="0 0 0"
        rpy="${pi / 2} 0 0" />
      <parent link="${prefix}carriage_left"/>
      <child link="${prefix}gripper_left"/>
    </joint>

    <link name="${prefix}gripper_right">
      <inertial>
        <origin
          xyz="0.00275423 0.00000726 0.02059910"
          rpy="0 0 0" />
        <mass value="0.03751074"/>
        <inertia
          ixx="0.00002087"
          ixy="0.00000000"
          ixz="-0.00000338"
          iyy="0.00002044"
          iyz="0.00000000"
          izz="0.00000456"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/gripper_right.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/gripper_right.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}right_gripper_joint" type="fixed">
      <origin
        xyz="0 0 0"
        rpy="${pi / 2} 0 0" />
      <parent link="${prefix}carriage_right"/>
      <child link="${prefix}gripper_right"/>
    </joint>

    <link name="${prefix}ee_gripper_link" />

    <joint name="${prefix}ee_gripper" type="fixed">
      <origin
        xyz="0.22 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_6"/>
      <child link="${prefix}ee_gripper_link"/>
    </joint>

    <link name="${prefix}camera_mount">
      <inertial>
        <origin
          xyz="-0.00493731 0.0 0.04433580"
          rpy="0 0 0" />
        <mass value="0.00853488"/>
        <inertia
          ixx="0.00000273"
          ixy="0.0"
          ixz="0.00000030"
          iyy="0.00000118"
          iyz="0.0"
          izz="0.00000196"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/camera_mount.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/camera_mount.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}camera_mount_joint" type="fixed">
      <origin
        xyz="0.102 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_6"/>
      <child link="${prefix}camera_mount"/>
    </joint>

    <xacro:zed_camera name="${prefix}wrist" model="zedxnano" parent="${prefix}link_6">
      <origin
        xyz="0.0933 0 0.05677"
        rpy="0 0.436332 0" />
    </xacro:zed_camera>

  </xacro:macro> <!-- wxheavy -->

</robot>
