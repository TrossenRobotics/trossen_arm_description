<?xml version="1.0" encoding="utf-8"?>
<robot name="wxcore" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="robot_model"
    value="wxcore"
    scope="local"/>

  <xacro:include filename="$(find trossen_arm_description)/urdf/peripherals/zed_camera.urdf.xacro" />

  <xacro:macro name="wxcore" params="prefix:=''">

    <xacro:property name="mesh_directory" value="package://trossen_arm_description/meshes/${robot_model}"/>

    <!-- TODO(abhismirai42): ros2_control -->

    <link name="${prefix}base_link">
      <inertial>
        <origin
          xyz="-0.00671439 0.00015929 0.04936050"
          rpy="0 0 0" />
        <mass value="1.05999025"/>
        <inertia
          ixx="0.00169813"
          ixy="0.00000821"
          ixz="-0.00007146"
          iyy="0.00208830"
          iyz="-0.00000414"
          izz="0.00185425"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/base_link.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/base_link.obj"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}link_1">
      <inertial>
        <origin
          xyz="0.00265807 -0.00223121 0.01713183"
          rpy="0 0 0" />
        <mass value="0.24434760"/>
        <inertia
          ixx="0.00030654"
          ixy="0.00001055"
          ixz="-0.00003439"
          iyy="0.00015923"
          iyz="0.00001202"
          izz="0.00031679"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_1.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_1.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_0" type="revolute">
      <origin
        xyz="0 0 0.096"
        rpy="0 0 0"/>
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <axis xyz="0 0 1"/>
      <limit
        lower="${-radians(165)}"
        upper="${radians(165)}"
        effort="27.0"
        velocity="3.375" />
    </joint>

    <link name="${prefix}link_2">
      <inertial>
        <origin
          xyz="-0.13201452 -0.00047895 0.00007208"
          rpy="0 0 0" />
        <mass value="1.28563686"/>
        <inertia
          ixx="0.00076836"
          ixy="0.00000135"
          ixz="-0.00000528"
          iyy="0.01793702"
          iyz="-0.00000123"
          izz="0.01805880"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_2.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_2.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_1" type="revolute">
      <origin
        xyz="0.02 0 0.044"
        rpy="0 0 0" />
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <axis xyz="0 1 0"/>
      <limit
        lower="0.0"
        upper="${radians(205)}"
        effort="27.0"
        velocity="3.375" />
    </joint>

    <link name="${prefix}link_3">
      <inertial>
        <origin
          xyz="0.14856512 -0.00093837 0.05470195"
          rpy="0 0 0" />
        <mass value="0.94523715"/>
        <inertia
          ixx="0.00084253"
          ixy="-0.00003556"
          ixz="-0.00075363"
          iyy="0.01013070"
          iyz="-0.00002509"
          izz="0.01007403"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_3.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_3.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_2" type="revolute">
      <origin
        xyz="-0.264 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <axis xyz="0 -1 0"/>
      <limit
        lower="0.0"
        upper="${pi}"
        effort="27.0"
        velocity="3.375" />
    </joint>

    <link name="${prefix}link_4">
      <inertial>
        <origin
          xyz="0.05026711 -0.00029826 0.05475366"
          rpy="0 0 0" />
        <mass value="0.45161249"/>
        <inertia
          ixx="0.00058366"
          ixy="-0.00000429"
          ixz="-0.00027871"
          iyy="0.00071884"
          iyz="-0.00000537"
          izz="0.00057217"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_4.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_4.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_3" type="revolute">
      <origin
        xyz="0.245 0 0.06"
        rpy="0 0 0" />
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <axis xyz="0 -1 0"/>
      <limit
        lower="-${pi / 2}"
        upper="${pi / 2}"
        effort="7.0"
        velocity="7.0" />
    </joint>

    <link name="${prefix}link_5">
      <inertial>
        <origin
          xyz="-0.00539755 -0.00000007 -0.02459526"
          rpy="0 0 0" />
        <mass value="0.04891458"/>
        <inertia
          ixx="0.0000265430"
          ixy="0.0000000000"
          ixz="-0.0000044943"
          iyy="0.0000248750"
          iyz="0.0000000000"
          izz="0.0000101230"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_5.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_5.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_4" type="revolute">
      <origin
        xyz="0.065 0 0.048"
        rpy="0 0 0" />
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <axis xyz="0 0 -1"/>
      <limit
        lower="-${pi / 2}"
        upper="${pi / 2}"
        effort="7.0"
        velocity="7.0" />
    </joint>

    <link name="${prefix}link_6">
      <inertial>
        <origin
          xyz="0.06477211 -0.00005660 -0.00026172"
          rpy="0 0 0" />
        <mass value="0.79969124"/>
        <inertia
          ixx="0.00045275"
          ixy="-0.00000048"
          ixz="-0.00000703"
          iyy="0.00122431"
          iyz="-0.00000034"
          izz="0.00124214"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_6.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_6.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_5" type="revolute">
      <origin
        xyz="-0.009 0.0 -0.048"
        rpy="0 0 0" />
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <axis xyz="1 0 0"/>
      <limit
        lower="${-radians(115)}"
        upper="${radians(115)}"
        effort="7.0"
        velocity="7.0" />
    </joint>

    <link name="${prefix}carriage_right">
      <inertial>
        <origin
          xyz="0.03198817 0.01024525 0.01710190"
          rpy="0 0 0" />
        <mass value="0.05823866"/>
        <inertia
          ixx="0.0000076862"
          ixy="-0.0000040815"
          ixz="-0.0000070993"
          iyy="0.0000307237"
          iyz="-0.0000014148"
          izz="0.0000263411"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/carriage_right.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/carriage_right.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}right_carriage_joint" type="prismatic">
      <origin
        xyz="0.1265 -0.0225 0"
        rpy="0 0 ${pi / 2}" />
      <parent link="${prefix}link_6"/>
      <child link="${prefix}carriage_right"/>
      <mimic joint="${prefix}left_carriage_joint"/>
      <axis xyz="-1 0 0"/>
      <limit
        lower="0.0"
        upper="0.045"
        effort="400.0"
        velocity="0.0875" />
    </joint>

    <link name="${prefix}carriage_left">
      <inertial>
        <origin
          xyz="0.03198817 0.01024525 0.01710190"
          rpy="0 0 0" />
        <mass value="0.05823866"/>
        <inertia
          ixx="0.0000076862"
          ixy="-0.0000040815"
          ixz="-0.0000070993"
          iyy="0.0000307237"
          iyz="-0.0000014148"
          izz="0.0000263411"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/carriage_left.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/carriage_left.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}left_carriage_joint" type="prismatic">
      <origin
        xyz="0.1265 0.0225 0"
        rpy="${pi} 0 -${pi / 2}" />
      <parent link="${prefix}link_6"/>
      <child link="${prefix}carriage_left"/>
      <axis xyz="-1 0 0"/>
      <limit
        lower="0.0"
        upper="0.045"
        effort="400.0"
        velocity="0.0875" />
    </joint>

    <link name="${prefix}gripper_left">
      <inertial>
        <origin
          xyz="0.00101084 -0.00003183 0.02641115"
          rpy="0 0 0" />
        <mass value="0.04941995"/>
        <inertia
          ixx="0.0000309841"
          ixy="-0.0000000016"
          ixz="-0.0000056184"
          iyy="0.0000323622"
          iyz="-0.0000000687"
          izz="0.0000056007"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/gripper_left.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/gripper_left.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}left_gripper_joint" type="fixed">
      <origin
        xyz="0 0 0"
        rpy="${pi / 2} 0 0" />
      <parent link="${prefix}carriage_left"/>
      <child link="${prefix}gripper_left"/>
    </joint>

    <link name="${prefix}gripper_right">
      <inertial>
        <origin
          xyz="0.00101084 -0.00003183 0.02641115"
          rpy="0 0 0" />
        <mass value="0.04941995"/>
        <inertia
          ixx="0.0000309841"
          ixy="-0.0000000016"
          ixz="-0.0000056184"
          iyy="0.0000323622"
          iyz="-0.0000000687"
          izz="0.0000056007"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/gripper_right.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/gripper_right.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}right_gripper_joint" type="fixed">
      <origin
        xyz="0 0 0"
        rpy="${pi / 2} 0 0" />
      <parent link="${prefix}carriage_right"/>
      <child link="${prefix}gripper_right"/>
    </joint>

    <link name="${prefix}ee_gripper_link" />

    <joint name="${prefix}ee_gripper" type="fixed">
      <origin
        xyz="0.218 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_6"/>
      <child link="${prefix}ee_gripper_link"/>
    </joint>

    <link name="${prefix}camera_mount">
      <inertial>
        <origin
          xyz="-0.00817605 -0.00042266 0.04038287"
          rpy="0 0 0" />
        <mass value="0.02632005"/>
        <inertia
          ixx="0.0000101629"
          ixy="0.0000000518"
          ixz="0.0000002760"
          iyy="0.0000067858"
          iyz="0.0000003826"
          izz="0.0000067649"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/camera_mount.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/camera_mount.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}camera_mount_joint" type="fixed">
      <origin
        xyz="0.102 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_6"/>
      <child link="${prefix}camera_mount"/>
    </joint>

    <xacro:zed_camera name="${prefix}wrist" model="zedxnano" parent="${prefix}link_6">
      <origin
        xyz="0.091112 0 0.057797"
        rpy="0 0.436332 0" />
    </xacro:zed_camera>

  </xacro:macro> <!-- wxcore -->

</robot>
