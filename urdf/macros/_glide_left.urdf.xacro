<?xml version="1.0" encoding="utf-8"?>
<robot name="glide_left" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="robot_model"
    value="glide_left"
    scope="local"/>

  <xacro:macro name="glide_left" params="prefix:=''">

    <xacro:property name="mesh_directory" value="package://trossen_arm_description/meshes/${robot_model}"/>

    <!-- TODO(abhismirai42): inertial properties are placeholders -->
    <!-- TODO(abhismirai42): joint limits not yet known for joint_6 (trigger) -->

    <link name="${prefix}base_link">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass value="0.001"/>
        <inertia
          ixx="0.0001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0001"
          iyz="0.0"
          izz="0.0001"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/base_link.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/base_link.obj"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}link_1">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass value="0.001"/>
        <inertia
          ixx="0.0001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0001"
          iyz="0.0"
          izz="0.0001"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_1.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_1.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_0" type="revolute">
      <origin
        xyz="0 0 0.09554"
        rpy="0 0 0" />
      <parent link="${prefix}base_link"/>
      <child link="${prefix}link_1"/>
      <axis xyz="0 0 1"/>
      <limit
        lower="-${pi}"
        upper="${pi}"
        effort="7.0"
        velocity="${3 * pi}" />
    </joint>

    <link name="${prefix}link_2">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass value="0.001"/>
        <inertia
          ixx="0.0001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0001"
          iyz="0.0"
          izz="0.0001"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_2.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_2.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_1" type="revolute">
      <origin
        xyz="0.02 0.06 0.0435"
        rpy="0 0 0" />
      <parent link="${prefix}link_1"/>
      <child link="${prefix}link_2"/>
      <axis xyz="0 1 0"/>
      <limit
        lower="0.0"
        upper="${pi}"
        effort="7.0"
        velocity="${3 * pi}" />
    </joint>

    <link name="${prefix}link_3">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass value="0.001"/>
        <inertia
          ixx="0.0001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0001"
          iyz="0.0"
          izz="0.0001"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_3.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_3.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_2" type="revolute">
      <origin
        xyz="-0.264 0 0"
        rpy="0 0 0" />
      <parent link="${prefix}link_2"/>
      <child link="${prefix}link_3"/>
      <axis xyz="0 -1 0"/>
      <limit
        lower="0.0"
        upper="${3 * pi / 4}"
        effort="7.0"
        velocity="${3 * pi}" />
    </joint>

    <link name="${prefix}link_4">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass value="0.001"/>
        <inertia
          ixx="0.0001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0001"
          iyz="0.0"
          izz="0.0001"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_4.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_4.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_3" type="revolute">
      <origin
        xyz="0.245 -0.0692419 0.06"
        rpy="0 0.360 0" />
      <parent link="${prefix}link_3"/>
      <child link="${prefix}link_4"/>
      <axis xyz="0 -1 0"/>
      <limit
        lower="-${pi / 2}"
        upper="${pi / 2}"
        effort="7.0"
        velocity="${3 * pi}" />
    </joint>

    <link name="${prefix}link_5">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass value="0.001"/>
        <inertia
          ixx="0.0001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0001"
          iyz="0.0"
          izz="0.0001"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_5.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_5.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_4" type="revolute">
      <origin
        xyz="0 0.00927356 0.0176"
        rpy="0 0 0.0" />
      <parent link="${prefix}link_4"/>
      <child link="${prefix}link_5"/>
      <axis xyz="0 0 -1"/>
      <limit
        lower="-${pi / 2}"
        upper="${pi / 2}"
        effort="7.0"
        velocity="${3 * pi}" />
    </joint>

    <link name="${prefix}link_6">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass value="0.001"/>
        <inertia
          ixx="0.0001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0001"
          iyz="0.0"
          izz="0.0001"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_6.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/link_6.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_5" type="revolute">
      <origin
        xyz="0.0435847 0 -0.0176"
        rpy="-0.89176 0 0" />
      <parent link="${prefix}link_5"/>
      <child link="${prefix}link_6"/>
      <axis xyz="1 0 0"/>
      <limit
        lower="-${pi}"
        upper="${pi}"
        effort="7.0"
        velocity="${3 * pi}" />
    </joint>

    <link name="${prefix}trigger">
      <inertial>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <mass value="0.001"/>
        <inertia
          ixx="0.0001"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0001"
          iyz="0.0"
          izz="0.0001"/>
      </inertial>
      <visual>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/trigger.obj"/>
        </geometry>
      </visual>
      <collision>
        <origin
          xyz="0 0 0"
          rpy="0 0 0" />
        <geometry>
          <mesh filename="${mesh_directory}/trigger.obj"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}joint_6" type="revolute">
      <origin
        xyz="0.114138 -0.012 0.0116"
        rpy="0 0 0" />
      <parent link="${prefix}link_6"/>
      <child link="${prefix}trigger"/>
      <axis xyz="0 -1 0"/>
      <limit
        lower="0.0"
        upper="${0.04 / 0.00875}"
        effort="${100.0 * 0.00875}"
        velocity="${0.25 / 0.00875}" />
    </joint>

  </xacro:macro> <!-- glide_left -->

</robot>
