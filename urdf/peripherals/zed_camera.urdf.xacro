<robot name="zed_camera" xmlns:xacro="http://ros.org/wiki/xacro">

  <!--
    Parameters:
      - name: prefix for every link and joint the macro creates
      - model: zedxm or zedxnano
      - parent: link the camera mounts to
      - origin: pose of the camera's bottom 1/4"-20 mounting hole in the parent frame,
        x toward the lenses, z up
  -->
  <xacro:macro name="zed_camera" params="name model parent *origin">

    <xacro:if value="${model == 'zedxm'}">
      <xacro:property name="baseline" value="0.05"/>
      <xacro:property name="height" value="0.032"/>
      <xacro:property name="screw_offset_z" value="-0.016"/>
      <xacro:property name="optical_offset_x" value="-0.01"/>
      <xacro:property name="mass" value="0.150"/>
      <xacro:property name="box_x" value="0.037"/>
      <xacro:property name="box_y" value="0.094"/>
    </xacro:if>
    <xacro:if value="${model == 'zedxnano'}">
      <xacro:property name="baseline" value="0.018"/>
      <xacro:property name="height" value="0.0305"/>
      <xacro:property name="screw_offset_z" value="-0.01525"/>
      <xacro:property name="optical_offset_x" value="-0.01"/>
      <xacro:property name="mass" value="0.075"/>
      <xacro:property name="box_x" value="0.0338"/>
      <xacro:property name="box_y" value="0.042"/>
    </xacro:if>

    <joint name="${name}_mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${name}_camera_link"/>
    </joint>

    <!-- Camera mounting point: the 1/4"-20 threaded hole in the bottom -->
    <link name="${name}_camera_link"/>

    <link name="${name}_camera_center">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia
          ixx="${mass * (box_y * box_y + height * height) / 12}"
          ixy="0.0"
          ixz="0.0"
          iyy="${mass * (box_x * box_x + height * height) / 12}"
          iyz="0.0"
          izz="${mass * (box_x * box_x + box_y * box_y) / 12}"/>
      </inertial>
      <visual>
        <origin xyz="0 0 ${screw_offset_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://trossen_arm_description/meshes/peripherals/${model}.stl"/>
        </geometry>
        <material name="zed_camera_mat">
          <color rgba="0.25 0.25 0.25 1.0"/>
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 ${screw_offset_z}" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://trossen_arm_description/meshes/peripherals/${model}.stl"/>
        </geometry>
      </collision>
    </link>
    <joint name="${name}_camera_center_joint" type="fixed">
      <parent link="${name}_camera_link"/>
      <child link="${name}_camera_center"/>
      <origin xyz="0 0 ${height / 2}" rpy="0 0 0"/>
    </joint>

    <link name="${name}_left_camera_frame"/>
    <joint name="${name}_left_camera_joint" type="fixed">
      <parent link="${name}_camera_center"/>
      <child link="${name}_left_camera_frame"/>
      <origin xyz="${optical_offset_x} ${baseline / 2} 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_left_camera_frame_optical"/>
    <joint name="${name}_left_camera_optical_joint" type="fixed">
      <parent link="${name}_left_camera_frame"/>
      <child link="${name}_left_camera_frame_optical"/>
      <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>

    <link name="${name}_right_camera_frame"/>
    <joint name="${name}_right_camera_joint" type="fixed">
      <parent link="${name}_camera_center"/>
      <child link="${name}_right_camera_frame"/>
      <origin xyz="${optical_offset_x} ${-baseline / 2} 0" rpy="0 0 0"/>
    </joint>

    <link name="${name}_right_camera_frame_optical"/>
    <joint name="${name}_right_camera_optical_joint" type="fixed">
      <parent link="${name}_right_camera_frame"/>
      <child link="${name}_right_camera_frame_optical"/>
      <origin xyz="0 0 0" rpy="${-pi / 2} 0 ${-pi / 2}"/>
    </joint>

  </xacro:macro>

</robot>
