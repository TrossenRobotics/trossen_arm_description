<?xml version="1.0" encoding="utf-8"?>
<robot name="wxpro" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:arg name="prefix"                          default=""/>
  <xacro:arg name="use_world_frame"                 default="false"/>       <!-- 'true', 'false' -->
  <xacro:arg name="base_link_frame"                 default="base_link"/>

  <!-- TODO(abhismirai42): make sure base_link name logic will hold! we are not passing the name -->
  <xacro:if value="$(arg use_world_frame)">
    <link name="world"/>
    <joint name="fixed" type="fixed">
      <parent
        link="world"/>
      <child
        link="$(arg base_link_frame)"/>
    </joint>
  </xacro:if> <!-- use_world_frame -->

  <xacro:include filename="$(find trossen_arm_description)/urdf/macros/_wxpro.urdf.xacro" />

  <xacro:wxpro
    prefix="$(arg prefix)"/>

</robot>
